<?xml version="1.0" encoding="UTF-8"?>
<Module>
    <ModulePrefs title="CBS gadget - Open CX "
        height="200">
        <Require feature="settitle" />
        <Require feature="dynamic-height" />
        <Require feature="pubsub-2" />
        <Require feature="setprefs" />
        <Require feature="loadingindicator">
            <Param name="manual-dismiss">false</Param>
            <Param name="loading-timeout">10</Param>
        </Require>
    </ModulePrefs>

    <Content type="html">
        <![CDATA[
            <!DOCTYPE html>
            <!--[if lt IE 7]>      <html class="lt-ie9 lt-ie8 lt-ie7"> <![endif]-->
            <!--[if IE 7]>         <html class="lt-ie9 lt-ie8"> <![endif]-->
            <!--[if IE 8]>         <html class="lt-ie9"> <![endif]-->
            <!--[if gt IE 8]>      <html> <!--<![endif]-->
            <head>
                <!-- Styling -->
                <link rel="stylesheet" href="bootstrap/2.3.2/css/bootstrap.min.css" type="text/css" />
                <link rel="stylesheet" href="OpenCX.css" type="text/css" />

                <!-- jQuery -->
                <script type="text/javascript" src="/desktop/assets/js/jquery.min.js"></script>
            
                <!-- Bootstrap -->
                <script type="text/javascript" src="bootstrap/2.3.2/js/bootstrap.min.js"></script>
               
                <!-- Finesse Library -->
                <script type="text/javascript" src="/desktop/assets/js/finesse.js"></script>
            
                <!-- Gadget Business Logic -->
                <script type="text/javascript" src="OpenCX.js"></script>
            </head>

            <body class="claro">
                <div id="successMsg" class="alert alert-success" style="display: none">
                    <strong>Congratulations!!!&nbsp;</strong>You have successfully initiated a START_RECORDING!
                </div>
                <div id="errorMsg" class="alert alert-error" style="display: none">
                    <h4>Uh Oh! An Error occurred when trying to START_RECORDING:</h4>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong>ErrorType:&nbsp;</strong><span id="errorMsgType"></span></div>
                    <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong>ErrorMessage:&nbsp;</strong><span id="errorMsgMessage"></span></div>
                </div>
                <label id="uiState"></label>
                <label id="uiEntered"></label>
                <label id="uiCallerID"></label>
                <button id="uiOpenButton" class="btn" onClick="finesse.modules.OpenCXGadget.openBtnPressed()" style="display: none">Open customer profile in CX</button>
            </body>

            <script type="text/javascript">
                gadgets.HubSettings.onConnect = function () {
                    finesse.modules.OpenCXGadget.init();
                };
            </script>
        ]]>
    </Content>
</Module>